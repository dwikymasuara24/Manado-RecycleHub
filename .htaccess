Options +FollowSymLinks -Indexes
DirectoryIndex index.php home.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect direct GET requests with .php to clean URLs
    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/include/ [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Short aliases for admin & officer root
    RewriteRule ^officer/?$ officer/dashboard [L,QSA]
    RewriteRule ^admin/?$ admin/dashboard [L,QSA]

    # If physical file or directory exists, serve as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Internal rewrite: append .php if physical file exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
